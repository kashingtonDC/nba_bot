    "OKC": 11.1,    # confirmed
    "LAL": 4.5,     # TODO_VERIFY — placeholder
    "DEN": 5.2,     # TODO_VERIFY — derived from earlier conversation
    "MIN": 3.0,     # TODO_VERIFY — derived from earlier conversation
    "SAS": 4.0,     # TODO_VERIFY — Wemby-led 2-seed, placeholder
    "HOU": 1.5,     # TODO_VERIFY — placeholder for 5-seed
    "POR": -0.5,    # TODO_VERIFY — placeholder for 7-seed
    "PHX": -1.0,    # TODO_VERIFY — placeholder for 8-seed

    # Eastern Conference playoff teams
    "BOS": 7.0,     # TODO_VERIFY — placeholder for 2-seed
    "DET": 6.0,     # TODO_VERIFY — best record in East per earlier conversation
    "CLE": 4.0,     # TODO_VERIFY — placeholder for 4-seed
    "NYK": 3.5,     # TODO_VERIFY — placeholder for 3-seed
    "TOR": 0.5,     # TODO_VERIFY — placeholder for 5-seed
