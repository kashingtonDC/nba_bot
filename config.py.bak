"""
Configuration for the NBA series prediction bot.

Edit this file to update:
  - Team net ratings after the regular season closes (TEAM_NET_RATINGS)
  - Current series state after each game completes (SERIES)
  - Model constants if you want to tune the calibration

All values flagged `# TODO_VERIFY` should be checked against
basketball-reference (https://www.basketball-reference.com/leagues/NBA_2026_ratings.html)
before relying on outputs. They were entered as best-guess placeholders for
v0 setup. The bot will log the values it uses on each run for audit.
"""
from __future__ import annotations
from dataclasses import dataclass, field
from typing import List, Tuple, Optional


# --- Model constants --------------------------------------------------------

HCA = 2.5            # home court advantage (points)
SIGMA_GAME = 11.5    # std dev of single-game margin (points)
SIGMA_THETA = 2.0    # prior uncertainty on team net rating
TAIL_CORRECTION_PP = 0.02  # magnitude of tail-bias adjustment


# --- Team net ratings (end of 2025-26 regular season) -----------------------

